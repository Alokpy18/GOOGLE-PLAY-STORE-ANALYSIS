import pandas as pd 
import numpy as np
import plotly.express as px
import plotly.graph_objects as go
from datetime import datetime
from zoneinfo import ZoneInfo

google_df = pd.read_csv("googleplaystoredata.csv")
print(google_df.shape)
print(google_df.columns.to_list())
print(google_df.head())
print(google_df.dtypes)
print(google_df.isnull().sum())

#data cleaning
google_df["Reviews"] = pd.to_numeric(google_df["Reviews"],errors="coerce")
google_df["Installs"] = (google_df["Installs"].str.replace(",", "", regex = False).str.replace("+", "", regex = False))

google_df["Installs"] = pd.to_numeric(google_df["Installs"], errors="coerce")

def convert_size(size):
    if pd.isna(size):
        return np.nan

    if "M" in size:
        return float(size.replace("M", ""))
    elif "k" in size:
        return float(size.replace("k", "")) / 1024
    return np.nan
google_df["Size_MB"] = google_df["Size"].apply(convert_size)

google_df["Last Updated"] = pd.to_datetime(google_df["Last Updated"], errors="coerce")
print(google_df[["Rating", "Reviews", "Installs", "Size_MB", "Last Updated"]].dtypes)

#apply filters
filtered_df = google_df[(google_df["Rating"] >= 4.2) & (~google_df["App"].str.contains(r"\d", na = False)) & 
                        (google_df["Category"].str.startswith(("T", "P"), na = False)) & 
                        (google_df["Reviews"] > 1000) & (google_df["Size_MB"].between(20, 80))].copy()

print(len(google_df))
print(len(filtered_df))

print(filtered_df[["App", "Category", "Rating", "Reviews", "Size_MB", "Installs", "Last Updated"]].head(10))

#prepare month-wise
filtered_df["Month"] = filtered_df["Last Updated"].dt.to_period("M").dt.to_timestamp()
monthly_installs = (filtered_df.groupby(["Month", "Category"])["Installs"].sum().reset_index())

print(monthly_installs.head(10))
print(monthly_installs["Category"].unique())

#cumulative installs
monthly_installs = monthly_installs.sort_values("Month")

monthly_installs["Cumulative_Installs"] = (
    monthly_installs.groupby("Category")["Installs"].cumsum()
)
print(monthly_installs.head(15))

#legend translation
category_translation = {
    "TRAVEL_AND_LOCAL": "Voyage et loisirs",
    "PRODUCTIVITY": "Productividad",
    "PHOTOGRAPHY": "写真"
}

monthly_installs["Category_Label"] = (
    monthly_installs["Category"]
    .map(category_translation)
    .fillna(monthly_installs["Category"])
)
print(monthly_installs[["Category", "Category_Label"]].drop_duplicates())

#month-over-month increase
monthly_installs = monthly_installs.sort_values(["Category", "Month"])
monthly_installs["Previous_Installs"] = (
    monthly_installs.groupby("Category")["Installs"].shift(1)
)
monthly_installs["MoM_Increase"] = (
    (monthly_installs["Installs"] - monthly_installs["Previous_Installs"])
      /
    monthly_installs["Previous_Installs"]  
) * 100
print(monthly_installs[["Month", "Category", "Previous_Installs", "MoM_Increase"]].head(20))

#identify the increasing more than 25%
monthly_installs["High_Growth"] = (
    monthly_installs["MoM_Increase"] > 25
)
print(monthly_installs[["Month", "Category", "MoM_Increase", "High_Growth"]].query("High_Growth == True"))

#make a staked area chart
area_data = monthly_installs.pivot(
    index = "Month",
    columns = "Category_Label",
    values = "Cumulative_Installs"
).fillna(0)
print(area_data.head())

fig = px.area(
    area_data,
    x=area_data.index,
    y=area_data.columns,
    title="Cumulative Installs Over Time by App Category"
)

fig.update_layout(
    xaxis_title="Month",
    yaxis_title="Cumulative Installs",
    legend_title="App Category"
)

current_time = datetime.now(ZoneInfo("Asia/Kolkata")).time()

start_time = datetime.strptime("16:00", "%H:%M").time()
end_time = datetime.strptime("18:00", "%H:%M").time()

if start_time <= current_time < end_time:
    fig.show()
    fig.write_html("Task_6_Stacked_Area_Chart.html")
else:
    print("Visualization is available only between 4 PM and 6 PM IST.")